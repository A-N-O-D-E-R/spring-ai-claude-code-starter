                <artifactId>spring-ai-claude-chat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.anode.ai</groupId>
                <artifactId>spring-ai-claude-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.anode.ai</groupId>
                <artifactId>spring-boot-starter-ai-claude</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.anode.ai</groupId>
                <artifactId>spring-boot-starter-ai-claude-chat</artifactId>
                <version>${project.version}</version>
